{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gardenstep SDLC v1 policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "required_check_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "require_dev": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "required_check_ids",
    "required_source_ids",
    "require_dev"
  ],
  "additionalProperties": false
}
