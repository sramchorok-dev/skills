{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gardenstep SDLC v1 evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "change_id": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "[0-9a-f]{40}"
      },
      "minProperties": 1
    },
    "harness_version": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "eval",
              "dev",
              "review"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "SKIPPED",
              "CANCELLED"
            ]
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0
          },
          "run_id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "runner_version": {
            "type": "string"
          },
          "tool_version": {
            "type": "string"
          },
          "artifact_uri": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "model": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "prompt_version": {
                "type": "string"
              },
              "judge_name": {
                "type": "string"
              },
              "judge_version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "prompt_version",
              "judge_name",
              "judge_version"
            ],
            "additionalProperties": false
          },
          "reviewer_session_id": {
            "type": "string"
          },
          "blocking_findings": {
            "type": "integer",
            "minimum": 0
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev"
            ]
          },
          "services_before": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "minProperties": 1
          },
          "services_after": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "minProperties": 1
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "exit_code",
          "total",
          "passed",
          "failed",
          "skipped",
          "cancelled",
          "run_id",
          "command",
          "started_at",
          "finished_at",
          "runner_version",
          "tool_version",
          "artifact_uri",
          "artifact_sha256",
          "model"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "manifest_sha256",
    "services",
    "harness_version",
    "checks"
  ],
  "additionalProperties": false
}
