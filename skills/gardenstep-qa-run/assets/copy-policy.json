{
  "_note": "A-11 문구 정책. allow 규칙은 경로 목록(paths) 또는 앞뒤 context_chars 글자 안의 정규식(context)으로 예외를 둔다. 정본은 QA 시트 A-11 합격 기준이며, 기준이 바뀌면 이 파일을 함께 고친다.",
  "context_chars": 40,
  "rules": [
    {"pattern": "48시간", "reason": "하자 접수 기한은 '받은 날부터 7일 안에'로 통일"},
    {"pattern": "마당", "reason": "'공간'으로 통일"},
    {"pattern": "이한결", "reason": "담당 표기는 '정원사업부'"},
    {"pattern": "한 가격에", "reason": "배달비는 별도 결제라 충돌"},
    {"pattern": "현장 확인 후 추가 비용", "reason": "패키지 금액 정책과 충돌"},
    {"pattern": "사람과초록 시공", "reason": "'가든스텝 시공'·'가든스텝 시공팀'으로 표기(문맥 예외 없음)"},
    {"pattern": "사람과초록 고객센터", "reason": "'가든스텝 고객센터'로 표기(문맥 예외 없음)"},
    {
      "pattern": "사람과초록",
      "reason": "시공 주체 표기는 '가든스텝 시공'. 회사 소개 자리만 유지",
      "allow": [
        {"paths": ["/terms", "/privacy-policy"], "reason": "약관·개인정보 처리방침의 사업자 표기"},
        {"context": "사업자|함께하는 곳|대표자|대표\\s*[:：]|통신판매", "reason": "푸터 사업자 정보·함께하는 곳 카드"}
      ]
    }
  ]
